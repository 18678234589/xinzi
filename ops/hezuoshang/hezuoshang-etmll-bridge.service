[Unit]
Description=Hezuoshang upstream order database read bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o "ProxyCommand=/usr/bin/ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -i /root/.ssh/hezuoshang-etmll -p 20622 -W %%h:%%p root@58.58.98.150" -i /root/.ssh/hezuoshang-etmll -L 172.17.0.1:13307:127.0.0.1:3306 root@192.168.1.254
Restart=always
RestartSec=300

[Install]
WantedBy=multi-user.target
